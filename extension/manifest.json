{
  "manifest_version": 3,
  "name": "コンテンツくん",
  "description": "どのページからでも、サイドパネルでコンテンツくんを開く（ネタを足す・今後 7 日・1 行を開いて書く）",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel"],
  "host_permissions": ["https://content-os.shia2n.jp/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "コンテンツくんを開く" }
}
